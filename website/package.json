{
  "name": "island-spotify-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro check && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "pages:dev": "wrangler pages dev dist --ip 127.0.0.1",
    "deploy": "npm run build && wrangler pages deploy dist --branch main",
    "test": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "astro": "7.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3",
    "wrangler": "4.135.0"
  },
  "license": "MIT"
}
